# Môi trường ảo và cache Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# IDE và hệ điều hành
.idea/
.DS_Store

# Trọng số YOLO: ultralytics tự tải lại khi chạy
*.pt

# Ảnh chụp từ camera (phím 'c' trong main.py, hoặc --headless): tránh lỡ đẩy ảnh cá nhân lên repo public
captures/

# Hiệu chỉnh vị trí đế robot (phím B trong main.py): riêng cho từng cách bố trí bàn, mặc định nằm trong code
calibration.json

# Thư mục demo: bản chép gọn để chạy demo (tạo lại từ code gốc khi code đổi)
demo/

# Mã 6 số trong đường dẫn chia sẻ màn hình (main.py tự tạo): ai có mã là xem và bấm được, không đẩy lên repo public
.phone_pin
